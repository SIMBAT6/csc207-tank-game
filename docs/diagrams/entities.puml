@startuml entities
title Ricochet Tanks - Entities

class Tank {
  + {static} DEFAULT_RADIUS: double
  + {static} SPEED: double
  + {static} ROTATION_SPEED: double
  + {static} FIRE_COOLDOWN: int
  + {static} MAX_BULLETS: int
  - id: int
  - x: double
  - y: double
  - angle: double
  - radius: double
  - alive: boolean
  - shielded: boolean
  - cooldown: int
  - weapon: Weapon
  + rotate(direction: int): void
  + drive(direction: int, maze: Maze): void
  + coolDown(): void
  + canFire(activeBullets: int): boolean
  + fire(): List<Bullet>
  + takeHit(): boolean
  + destroy(): void
  + setWeapon(weapon: Weapon): void
  + setRadius(radius: double): void
  + tryResetRadius(maze: Maze): boolean
  + setShielded(shielded: boolean): void
}

interface Weapon {
  + createBullets(tank: Tank): List<Bullet>
}

class StandardWeapon

class Bullet {
  + {static} DEFAULT_RADIUS: double
  + {static} SPEED: double
  + {static} LIFETIME: int
  + {static} ARMING_DISTANCE: double
  - ownerId: int
  - x: double
  - y: double
  - velocityX: double
  - velocityY: double
  - lifetime: int
  - distanceTravelled: double
  + update(maze: Maze): void
  + age(): void
  + hits(t: Tank): boolean
  + isExpired(): boolean
  + expire(): void
  + getRadius(): double
  + getStepsPerTick(): int
  # hitsWall(maze: Maze): boolean
  + onHitTank(): void
  + getPath(): List<double[]>
}

class Maze {
  - rows: int
  - cols: int
  - cellSize: int
  + blocksCircle(x: double, y: double, radius: double): boolean
  + contains(x: double, y: double): boolean
  + getWidth(): int
  + getHeight(): int
  + getRandomEmptyCell(): Point
  + getSpawnPoints(): List<Point>
}

class Wall {
  - x: int
  - y: int
  - width: int
  - height: int
  + intersectsCircle(x: double, y: double, radius: double): boolean
}

abstract class PowerUp {
  - x: double
  - y: double
  - duration: int
  + {abstract} fire(t: Tank): List<Bullet>
  + isExpired(): boolean
}

class ShotgunPowerUp
class LaserPowerUp
class ShieldPowerUp

class Player {
  - username: String
  - isGuest: boolean
  - wins: int
  - losses: int
  + recordWin(): void
  + recordLoss(): void
}

class Match {
  - score1: int
  - score2: int
  - roundOver: boolean
  + tick(): void
  + startRound(): void
  + endRound(winner: Player): void
}

PowerUp <|-- ShotgunPowerUp
PowerUp <|-- LaserPowerUp
PowerUp <|-- ShieldPowerUp

Maze "1" *-- "many" Wall
Match "1" o-- "2" Player
Match "1" *-- "2" Tank
Match "1" *-- "1" Maze
Match "1" *-- "many" Bullet
Match "1" *-- "many" PowerUp
Tank "1" o-- "1" Weapon
StandardWeapon ..|> Weapon
Bullet --> Tank : owner

@enduml
